# Cấu hình cụm Spark Worker (2 Workers x 2.0 CPU & 6G RAM = 12G RAM)
SPARK_WORKER_CPU=2.0
SPARK_WORKER_MEM=6G

# Cấu hình cụm Flink TaskManager (2 TMs x 2.0 CPU & 6G RAM = 12G RAM)
FLINK_TM_CPU=2.0
FLINK_TM_MEM=6G


APP_ENV="benchmark"